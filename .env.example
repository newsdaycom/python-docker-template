# Purpose:
#   Provide safe local defaults for services generated from this template.
#
# Usage:
#   Copy this file to .env before running Docker Compose locally.
#
# Operational Notes:
#   Keep this file free of secrets. Use placeholder or local-only values for
#   sensitive settings and document the real secret source in docs/configuration.md.

# Runtime environment name used by Docker, Compose, and the Python entry point.
ENV=local

# Local build identifier surfaced in startup logs and runtime metadata.
BUILD_VERSION=local-build

# Conventional logging verbosity for generated services that implement logging.
LOG_LEVEL=info

# Local-friendly log formatting flag for generated services that support it.
LOG_PRETTY=on
