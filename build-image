#!/usr/bin/env bash
# Purpose:
#   Build and push a timestamped Docker image for a generated Python service.
#
# Usage:
#   ENV=production REPO_NAME=newsday/example-service ./build-image
#
# Environment:
#   ENV is required and becomes the image runtime environment.
#   REPO_NAME is required and should be the remote image repository.
#
# Outputs:
#   Pushes an image tagged as build-<branch>-<timestamp>.
#
# Side Effects:
#   Reads the current Git branch, builds a Docker image, and pushes it to the
#   configured registry.
set -euo pipefail

# Resolve the repository root relative to this script so it works from any cwd.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
cd "${SCRIPT_DIR}"

# Fail early with actionable messages when required deployment inputs are absent.
: "${ENV:?Set ENV before building, for example ENV=production.}"
: "${REPO_NAME:?Set REPO_NAME before building, for example REPO_NAME=newsday/example-service.}"

# Use the branch name in the image tag, replacing slashes with Docker-safe dashes.
BRANCH="$(git rev-parse --abbrev-ref HEAD)"
SAFE_BRANCH="${BRANCH//\//-}"
TAG="build-${SAFE_BRANCH}-$(date '+%Y%m%d%H%M%S')"

# Pass the tag into the image as BUILD_VERSION so runtime logs can identify it.
docker build \
  --tag "${REPO_NAME}:${TAG}" \
  --build-arg "ENV=${ENV}" \
  --build-arg "BUILD_VERSION=${TAG}" \
  .

docker push "${REPO_NAME}:${TAG}"

# Emit the final image reference for deployment tooling or manual follow-up.
echo "BUILD COMPLETE: ${REPO_NAME}:${TAG}"
