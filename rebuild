#!/usr/bin/env bash
# Purpose:
#   Rebuild, restart, and follow logs for the local Compose service.
#
# Usage:
#   ENV=local ./rebuild
#
# Environment:
#   ENV defaults to local and is passed to both build and runtime.
#   BUILD_VERSION defaults to local-build for repeatable local runs.
#
# Side Effects:
#   Builds the image, stops existing containers, removes stopped containers,
#   starts the service detached, and attaches to Compose logs.
set -euo pipefail

# Provide local defaults while still allowing shell or .env overrides.
export ENV="${ENV:-local}"
export BUILD_VERSION="${BUILD_VERSION:-local-build}"

# Rebuild the local image so dependency and Dockerfile changes are included.
docker compose build --build-arg "ENV=${ENV}" --build-arg "BUILD_VERSION=${BUILD_VERSION}"

# Restart from a clean stopped-container state.
docker compose stop
docker compose rm -f
docker compose up -d

# Follow logs as the final step so startup failures are visible immediately.
docker compose logs --follow
